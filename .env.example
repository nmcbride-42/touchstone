# Copy to .env (or export in your shell). Only needed for the LLM examples;
# the tests, examples/01, examples/02 (without --llm) and the artifact
# re-verification run fully offline.

# Which backend proposers use: anthropic | openai | command
TOUCHSTONE_LLM_PROVIDER=anthropic

# Islands for examples/03_island_swarm.py: one provider per island.
TOUCHSTONE_SWARM=anthropic,openai

# --- anthropic (official SDK; pip install -e ".[anthropic]") ---
ANTHROPIC_API_KEY=your-anthropic-api-key
TOUCHSTONE_ANTHROPIC_MODEL=claude-opus-5-5
TOUCHSTONE_ANTHROPIC_EFFORT=medium
# Server-side refusal fallback (beta). "default" or "off".
TOUCHSTONE_ANTHROPIC_FALLBACKS=default

# --- openai or any OpenAI-compatible server (pip install -e ".[openai]") ---
OPENAI_API_KEY=your-openai-api-key
TOUCHSTONE_OPENAI_MODEL=your-model-id
# Leave empty for api.openai.com; set for vLLM / llama.cpp / Ollama / OpenRouter.
TOUCHSTONE_OPENAI_BASE_URL=
TOUCHSTONE_OPENAI_TEMPERATURE=

# --- command: any CLI that reads the prompt on stdin, prints the reply ---
TOUCHSTONE_LLM_COMMAND=

# Per-call timeout in seconds (all providers).
TOUCHSTONE_LLM_TIMEOUT=300

# Paths (defaults shown relative to the repo root).
TOUCHSTONE_DATA_DIR=./data
TOUCHSTONE_OUTPUT_DIR=./runs

# Set to 1 to run tests marked `network` (makes one real LLM call).
TOUCHSTONE_RUN_NETWORK_TESTS=0
